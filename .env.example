# Copy this file to .env.local for local development.
# On Vercel, add these in Project Settings -> Environment Variables.

# Required: the password for /admin. Choose a strong one.
ADMIN_PASSWORD=M1236@di

# Recommended: a long random string used to sign login sessions.
# Example generator: openssl rand -hex 32
SESSION_SECRET=i am in my mind that sometimes thing this word is greet or not

# Required on Vercel to save changes (Upstash Redis).
# Added automatically when you connect Upstash from the Vercel Marketplace,
# but KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
